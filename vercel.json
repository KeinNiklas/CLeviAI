{
    "version": 2,
    "functions": {
        "api/index.py": {
            "runtime": "@vercel/python@6.12.0",
            "excludeFiles": "{frontend/**,api/.venv/**,api/venv/**,api/tests/**,api/build/**,api/data/**,api/.pytest_cache/**,scripts/**}"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}